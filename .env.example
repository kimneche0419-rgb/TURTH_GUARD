# Truth History SDK 환경 변수 템플릿
# 사용법: 이 파일을 `.env`로 복사한 뒤 값을 채웁니다. `.env`는 .gitignore에 등록되어 Git에 커밋되지 않습니다.
# (th init 실행 시 빈 .env 파일이 자동 생성됩니다.)

# REST API 요청 인증 키 — 설정 시 X-API-Key 헤더가 일치하는 요청만 허용 (미설정 시 인증 없이 개방)
TRUTHHISTORY_API_KEY=

# Google Fact Check Search API 키 (선택 — 팩트체크 증거 소스 활성화)
FACT_CHECK_API_KEY=

# Naver 통합 웹검색 API 자격증명 (선택 — 한국어·한국사 특화 증거 수집)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
